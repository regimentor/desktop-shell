[Unit]
Description=Daevox desktop panel (Quickshell)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=exec
ExecStart=/usr/bin/qs --no-duplicate --log-rules quickshell.io.socket.warning=false --path %h/.config/quickshell/daevox-bar/shell.qml
Restart=on-failure
RestartSec=1
Slice=app-graphical.slice

[Install]
WantedBy=graphical-session.target
